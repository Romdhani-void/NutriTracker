												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "If Any Pod Shows ErrImagePull"
												},
												{
													"type": "text",
													"text": " (the ECR re-tag fix, in case it happens again)"
												}
											]
										}
